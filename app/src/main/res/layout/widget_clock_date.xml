<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05070D">
    <ImageView
        android:id="@+id/kids_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/kids_clock"
        android:scaleType="fitXY"
        android:contentDescription="The four children holding the RK Solution clock" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="#F0000000">
        <TextClock
            android:id="@+id/widget_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:format12Hour="h:mm a"
            android:format24Hour="HH:mm"
            android:textColor="#73D9FF"
            android:textSize="19sp"
            android:fontFamily="sans-serif-black"
            android:includeFontPadding="false" />
        <TextClock
            android:id="@+id/widget_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="EEE, dd MMM"
            android:format24Hour="EEE, dd MMM"
            android:textColor="#FFD84D"
            android:textSize="11sp"
            android:fontFamily="sans-serif-bold" />
    </LinearLayout>
</FrameLayout>