<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <ImageView
        android:id="@+id/kids_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/kids_clock_transparent"
        android:scaleType="fitCenter"
        android:background="@android:color/transparent"
        android:contentDescription="Four children holding a clock and calendar" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="9dp"
        android:orientation="vertical"
        android:gravity="end"
        android:background="@android:color/transparent">

        <TextClock
            android:id="@+id/widget_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="h:mm a"
            android:format24Hour="HH:mm"
            android:textColor="#73D9FF"
            android:textSize="15sp"
            android:fontFamily="sans-serif-black"
            android:includeFontPadding="false" />

        <TextClock
            android:id="@+id/widget_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="EEE, dd MMM"
            android:format24Hour="EEE, dd MMM"
            android:textColor="#FFFFFF"
            android:textSize="8sp"
            android:fontFamily="sans-serif-bold" />
    </LinearLayout>
</FrameLayout>